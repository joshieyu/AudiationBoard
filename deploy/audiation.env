NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATA_DIR=/srv/audiation/data
MAX_UPLOAD_MB=250
# Refuse uploads when less than this much disk is left, so other sites on the server keep running.
MIN_FREE_GB=8
# The admin page warns once free space drops below this (default MIN_FREE_GB + 5).
WARN_FREE_GB=13
# ADMIN_KEY unlocks /admin. setup-server.sh generates one; never commit it.
